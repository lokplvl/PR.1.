// Perfolenta.NET

модуль ИнтерпретаторКоманд
{
    функция Интерпретировать(команда : КомандаПользователя, контекстДиалога : словарь<строка, объект>?) : РезультатИнтерпретации
    {
        перем текст = НижнийРегистр(Обрезать(команда.Текст));
        перем результат = новый РезультатИнтерпретации();
        результат.Поля = контекстДиалога ?? новый словарь<строка, объект>();
        результат.КлючДиалога = команда.КлючДиалога;

        // Если есть активное уточнение, пробуем дозаполнить поля текущей интенции.
        если результат.Поля["ожидаемая_интенция"] != null тогда
            вернуть ДополнитьПослеУточнения(текст, результат);

        // Вода
        если Совпадает(текст, "сколько.*вод") тогда вернуть ИнтенцияВодыЗаДень(результат);
        если Совпадает(текст, "(выпил|вода|запиши воду|добавь.*мл)") тогда вернуть РазобратьВоду(текст, результат);

        // Стресс
        если Совпадает(текст, "стресс|тревож|нервнича") тогда вернуть РазобратьСтресс(текст, результат);

        // Настроение
        если Совпадает(текст, "настроен|рад|груст|спокой|подав|отлич") тогда вернуть РазобратьНастроение(текст, результат);

        // Сон
        если Совпадает(текст, "сон|спал|лег|лёг|проснул") тогда вернуть РазобратьСон(текст, результат);

        // Питание
        если Совпадает(текст, "завтрак|обед|ужин|перекус|поел|пищ") тогда вернуть РазобратьПитание(текст, результат);

        // Тренировка
        если Совпадает(текст, "трениров|бег|йога|силов|ходьб|вел") тогда вернуть РазобратьТренировку(текст, результат);

        // Задачи
        если Совпадает(текст, "созд.*задач|добав.*задач|постав.*задач") тогда вернуть РазобратьСозданиеЗадачи(текст, результат);
        если Совпадает(текст, "закр.*задач|выполн.*задач|верни задачу") тогда вернуть РазобратьЗакрытиеЗадачи(текст, результат);
        если Совпадает(текст, "задачи на сегодня|список задач|покажи задачи|просроченн|по crm") тогда вернуть РазобратьСписокЗадач(текст, результат);

        // Помодоро
        если Совпадает(текст, "стоп помодоро|заверши помодоро|останови фокус|отмени помодоро") тогда вернуть ИнтенцияСтопПомодоро(текст, результат);
        если Совпадает(текст, "помодоро|фокус") тогда вернуть РазобратьСтартПомодоро(текст, результат);

        // Клиенты / оплаты / карточка
        если Совпадает(текст, "добавь клиента|новый клиент|клиент.*(телефон|почта|имя)") тогда вернуть РазобратьДобавитьКлиента(текст, результат);
        если Совпадает(текст, "оплатил|оплата|оплачен|пришла оплата") тогда вернуть РазобратьОплату(текст, результат);
        если Совпадает(текст, "покажи клиента|карточка клиента|открой клиента") тогда вернуть РазобратьКарточкуКлиента(текст, результат);

        // Сделки
        если Совпадает(текст, "создай сделку|переведи сделку|закрой сделку") тогда вернуть РазобратьСделку(текст, результат);

        // Отчёт
        если Совпадает(текст, "отчет за день|отчёт за день|дневной отчёт|как прошёл день") тогда вернуть ИнтенцияОтчётаЗаДень(текст, результат);

        результат.НужноУточнение = истина;
        результат.Вопрос = "Не понял команду. Уточните действие: вода, стресс, настроение, сон, питание, тренировка, задачи, помодоро, клиент, отчёт.";
        вернуть результат;
    }

    функция ДополнитьПослеУточнения(текст, результат)
    {
        перем инт = ВСтроку(результат.Поля["ожидаемая_интенция"]);
        если инт = "ЗаписатьВоду" тогда вернуть РазобратьВоду(текст, результат);
        если инт = "ЗаписатьСтресс" тогда вернуть РазобратьСтресс(текст, результат);
        если инт = "ЗаписатьНастроение" тогда вернуть РазобратьНастроение(текст, результат);
        если инт = "ЗаписатьСон" тогда вернуть РазобратьСон(текст, результат);
        если инт = "ЗаписатьПитание" тогда вернуть РазобратьПитание(текст, результат);
        если инт = "ЗаписатьТренировку" тогда вернуть РазобратьТренировку(текст, результат);
        если инт = "СоздатьЗадачу" тогда вернуть РазобратьСозданиеЗадачи(текст, результат);
        если инт = "ЗакрытьЗадачу" тогда вернуть РазобратьЗакрытиеЗадачи(текст, результат);
        если инт = "НачатьПомодоро" тогда вернуть РазобратьСтартПомодоро(текст, результат);
        если инт = "ДобавитьКлиента" тогда вернуть РазобратьДобавитьКлиента(текст, результат);
        если инт = "КлиентОплатил" тогда вернуть РазобратьОплату(текст, результат);
        вернуть результат;
    }

    функция РазобратьВоду(текст, результат)
    {
        результат.Интенция = "ЗаписатьВоду";
        результат.ТипСобытияL1 = "ВыпилВоду";
        перем мл = ПервоеЧислоПеред(текст, "мл");
        если мл = null и Совпадает(текст, "стакан") тогда мл = 250;
        если мл = null тогда
        {
            результат.Поля["ожидаемая_интенция"] = "ЗаписатьВоду";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Сколько мл воды записать?";
        }
        иначе
        {
            результат.Поля["объём_мл"] = мл;
            результат.НужноУточнение = ложь;
        }
        вернуть результат;
    }

    функция ИнтенцияВодыЗаДень(результат)
    {
        результат.Интенция = "ПоказатьВодуЗаДень";
        результат.ТипСобытияL1 = "ЗапросВодыЗаДень";
        вернуть результат;
    }

    функция РазобратьСтресс(текст, результат)
    {
        результат.Интенция = "ЗаписатьСтресс";
        результат.ТипСобытияL1 = "Стресс";
        если Совпадает(текст, "прош(е|ё)л") тогда
        {
            результат.Поля["статус"] = "завершён";
            вернуть результат;
        }

        перем число = ПервоеЧисло(текст);
        если число = null тогда
        {
            результат.Поля["ожидаемая_интенция"] = "ЗаписатьСтресс";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Оцените стресс от 1 до 10.";
        }
        иначе
        {
            результат.Поля["интенсивность"] = число;
            результат.Поля["причина"] = ПослеМаркеров(текст, ["из-за", "после"]);
            результат.НужноУточнение = ложь;
        }
        вернуть результат;
    }

    функция РазобратьНастроение(текст, результат)
    {
        результат.Интенция = "ЗаписатьНастроение";
        результат.ТипСобытияL1 = "Настроение";
        результат.Поля["эмоция"] = ПервоеСовпадение(текст, "рад|груст|спокой|подав|отлич") ?? "нейтрально";
        перем число = ПервоеЧисло(текст);
        если число = null тогда
        {
            результат.Поля["ожидаемая_интенция"] = "ЗаписатьНастроение";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Оцените настроение по шкале от 1 до 10.";
        }
        иначе
        {
            результат.Поля["оценка"] = число;
            результат.НужноУточнение = ложь;
        }
        вернуть результат;
    }

    функция РазобратьСон(текст, результат)
    {
        результат.Интенция = "ЗаписатьСон";
        результат.ТипСобытияL1 = "Сон";
        перем время = ПервоеСовпадение(текст, "[0-2]?[0-9]:[0-5][0-9]");
        перем часы = ПервоеЧислоПеред(текст, "час");

        если Совпадает(текст, "лег|лёг") и время != null тогда результат.Поля["время_начала"] = время;
        если Совпадает(текст, "проснул") и время != null тогда результат.Поля["время_окончания"] = время;
        если часы != null тогда результат.Поля["сон_часы"] = часы;
        если Совпадает(текст, "хорош|плох|средн") тогда результат.Поля["качество"] = ВырезатьМаркерКачества(текст);

        если результат.Поля["время_начала"] = null и результат.Поля["время_окончания"] = null и результат.Поля["сон_часы"] = null тогда
        {
            результат.Поля["ожидаемая_интенция"] = "ЗаписатьСон";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Когда легли и проснулись?";
        }
        вернуть результат;
    }

    функция РазобратьПитание(текст, результат)
    {
        результат.Интенция = "ЗаписатьПитание";
        результат.ТипСобытияL1 = "Питание";
        перем тип = ПервоеСовпадение(текст, "завтрак|обед|ужин|перекус");
        перем ккал = ПервоеЧислоПеред(текст, "ккал");
        если тип != null тогда результат.Поля["тип"] = тип;
        если ккал != null тогда результат.Поля["ккал"] = ккал;
        результат.Поля["состав"] = ПослеМаркеров(текст, [":", "поел", "перекусил"]);

        если результат.Поля["тип"] = null и Пусто(ВСтроку(результат.Поля["состав"] ?? "")) тогда
        {
            результат.Поля["ожидаемая_интенция"] = "ЗаписатьПитание";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Что именно съели?";
        }
        вернуть результат;
    }

    функция РазобратьТренировку(текст, результат)
    {
        результат.Интенция = "ЗаписатьТренировку";
        результат.ТипСобытияL1 = "Тренировка";
        результат.Поля["тип"] = ПервоеСовпадение(текст, "бег|йога|силов|ходьб|вел") ?? "тренировка";
        результат.Поля["нагрузка"] = ПервоеСовпадение(текст, "низк|средн|высок") ?? "средняя";
        перем минуты = ПервоеЧислоПеред(текст, "мин");
        если минуты = null тогда
        {
            результат.Поля["ожидаемая_интенция"] = "ЗаписатьТренировку";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Сколько минут длилась тренировка?";
        }
        иначе результат.Поля["длительность"] = минуты;
        вернуть результат;
    }

    функция РазобратьСозданиеЗадачи(текст, результат)
    {
        результат.Интенция = "СоздатьЗадачу";
        результат.ТипСобытияL1 = "СоздатьЗадачу";
        перем название = ПослеМаркеров(текст, ["создай задачу", "добавь задачу", "поставь задачу"]);
        если Пусто(название) тогда
        {
            результат.Поля["ожидаемая_интенция"] = "СоздатьЗадачу";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Как назвать задачу?";
        }
        иначе
        {
            результат.Поля["название"] = название;
            если Совпадает(текст, "важн") тогда результат.Поля["приоритет"] = "высокий";
        }
        вернуть результат;
    }

    функция РазобратьЗакрытиеЗадачи(текст, результат)
    {
        если Совпадает(текст, "верни задачу") тогда
        {
            результат.Интенция = "ПереоткрытьЗадачу";
            результат.ТипСобытияL1 = "ЗакрытьЗадачу";
        }
        иначе
        {
            результат.Интенция = "ЗакрытьЗадачу";
            результат.ТипСобытияL1 = "ЗакрытьЗадачу";
        }

        перем идентификатор = ПервоеЧисло(текст);
        если идентификатор = null тогда
        {
            результат.Поля["название"] = ПослеМаркеров(текст, ["задачу"]);
            если Пусто(ВСтроку(результат.Поля["название"] ?? "")) тогда
            {
                результат.Поля["ожидаемая_интенция"] = "ЗакрытьЗадачу";
                результат.НужноУточнение = истина;
                результат.Вопрос = "Какую задачу закрыть: номер или название?";
            }
        }
        иначе результат.Поля["задача_id"] = идентификатор;
        вернуть результат;
    }

    функция РазобратьСписокЗадач(текст, результат)
    {
        результат.Интенция = "СписокЗадачНаСегодня";
        результат.ТипСобытияL1 = "СписокЗадач";
        результат.Поля["фильтр"] = "сегодня";
        если Совпадает(текст, "просроч") тогда результат.Поля["фильтр"] = "просроченные";
        если Совпадает(текст, "по crm") тогда результат.Поля["проект"] = "CRM";
        вернуть результат;
    }

    функция РазобратьСтартПомодоро(текст, результат)
    {
        результат.Интенция = "НачатьПомодоро";
        результат.ТипСобытияL1 = "НачатьПомодоро";

        перем пара = ПервоеСовпадениеГрупп(текст, "([0-9]{1,3})\s*[/ ]\s*([0-9]{1,3})");
        если пара != null тогда
        {
            результат.Поля["минуты_работы"] = ВЦелое(пара[1]);
            результат.Поля["минуты_отдыха"] = ВЦелое(пара[2]);
        }
        иначе
        {
            перем толькоРабота = ПервоеЧислоПеред(текст, "мин");
            если толькоРабота != null тогда
            {
                результат.Поля["минуты_работы"] = толькоРабота;
                результат.Поля["минуты_отдыха"] = 5;
            }
            иначе
            {
                результат.Поля["минуты_работы"] = 25;
                результат.Поля["минуты_отдыха"] = 5;
            }
        }

        перем задача = ПослеМаркеров(текст, ["задача", "по задаче"]);
        если !Пусто(задача) тогда результат.Поля["задача"] = задача;
        вернуть результат;
    }

    функция ИнтенцияСтопПомодоро(текст, результат)
    {
        результат.Интенция = "ЗавершитьПомодоро";
        результат.ТипСобытияL1 = "ЗавершитьПомодоро";
        результат.Поля["статус_завершения"] = если Совпадает(текст, "отмени") тогда "прервана" иначе "завершена";
        вернуть результат;
    }

    функция РазобратьДобавитьКлиента(текст, результат)
    {
        результат.Интенция = "ДобавитьКлиента";
        результат.ТипСобытияL1 = "ДобавитьКлиента";

        перем телефон = ПервоеСовпадение(текст, "(\+?[0-9]{7,15}|89[0-9]{8,10})");
        перем имя = ПослеМаркеров(текст, ["добавь клиента", "новый клиент", "клиент", "имя"]);

        если Пусто(имя) тогда
        {
            результат.Поля["ожидаемая_интенция"] = "ДобавитьКлиента";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Назовите ФИО клиента.";
        }
        иначе результат.Поля["фио"] = имя;

        если !Пусто(телефон) тогда результат.Поля["телефон"] = телефон;
        вернуть результат;
    }

    функция РазобратьОплату(текст, результат)
    {
        результат.Интенция = "КлиентОплатил";
        результат.ТипСобытияL1 = "КлиентОплатил";
        перем сумма = ПервоеЧисло(текст);
        перем клиент = ПослеМаркеров(текст, ["от", "клиента"]);

        если сумма = null тогда
        {
            результат.Поля["ожидаемая_интенция"] = "КлиентОплатил";
            результат.НужноУточнение = истина;
            результат.Вопрос = "Укажите сумму оплаты числом.";
        }
        иначе результат.Поля["сумма"] = сумма;

        если !Пусто(клиент) тогда результат.Поля["клиент"] = клиент;
        вернуть результат;
    }

    функция РазобратьКарточкуКлиента(текст, результат)
    {
        результат.Интенция = "КарточкаКлиента";
        результат.ТипСобытияL1 = "КарточкаКлиента";
        перем имя = ПослеМаркеров(текст, ["клиента", "клиент"]);
        если Пусто(имя) тогда
        {
            результат.НужноУточнение = истина;
            результат.Вопрос = "Уточните имя клиента.";
        }
        иначе результат.Поля["фио"] = имя;
        вернуть результат;
    }

    функция РазобратьСделку(текст, результат)
    {
        если Совпадает(текст, "создай сделку") тогда
        {
            результат.Интенция = "СоздатьСделку";
            результат.ТипСобытияL1 = "СоздатьСделку";
            результат.Поля["сумма"] = ПервоеЧисло(текст);
            результат.Поля["клиент"] = ПослеМаркеров(текст, ["с", "для"]);
            если результат.Поля["сумма"] = null тогда
            {
                результат.НужноУточнение = истина;
                результат.Вопрос = "Укажите клиента и сумму сделки.";
            }
            вернуть результат;
        }
        если Совпадает(текст, "переведи сделку") тогда
        {
            результат.Интенция = "ОбновитьСтадиюСделки";
            результат.ТипСобытияL1 = "ОбновитьСтадиюСделки";
            результат.Поля["стадия"] = ПослеМаркеров(текст, ["стадию"]);
            вернуть результат;
        }
        результат.Интенция = "ЗакрытьСделку";
        результат.ТипСобытияL1 = "ЗакрытьСделку";
        результат.Поля["результат"] = если Совпадает(текст, "успеш") тогда "успех" иначе "закрыта";
        вернуть результат;
    }

    функция ИнтенцияОтчётаЗаДень(текст, результат)
    {
        результат.Интенция = "ОтчётЗаДень";
        результат.ТипСобытияL1 = "ОтчётЗаДень";

        перем датаСтрока = ПервоеСовпадение(текст, "[0-9]{1,2}\.[0-9]{1,2}(\.[0-9]{2,4})?");
        если датаСтрока != null тогда
        {
            если !ПохожеНаДату(датаСтрока) тогда
            {
                результат.НужноУточнение = истина;
                результат.Вопрос = "Не удалось распознать дату. Укажите дату в формате ДД.ММ или ДД.ММ.ГГГГ.";
            }
            иначе результат.Поля["дата"] = датаСтрока;
        }
        если Совпадает(текст, "воде и задач") тогда результат.Поля["фокус"] = "вода,задачи";
        вернуть результат;
    }
}
