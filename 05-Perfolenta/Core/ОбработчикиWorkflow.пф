// Perfolenta.NET

класс ОбработчикиWorkflow
{
    приватное поле Хранилище : ХранилищеSQLite;

    конструктор(хранилище : ХранилищеSQLite)
    {
        Хранилище = хранилище;
    }

    функция ЗаписатьВоду(рез) : ОтветПользователю
    {
        перем мл = ВЦелое(рез.Поля["объём_мл"]);
        Хранилище.СохранитьСобытие("ВыпилВоду", "здоровье", "команда", ВJson(рез.Поля), null, null, null);
        вернуть Успех("Записал " + мл + " мл воды.");
    }

    функция ПоказатьВодуЗаДень(рез) : ОтветПользователю
    {
        перем дата = ФорматДаты(Сейчас(), "yyyy-MM-dd");
        перем сумма = Хранилище.СуммаВодыЗаДень(дата);
        Хранилище.СохранитьСобытие("ЗапросВодыЗаДень", "здоровье", "команда", "{}", null, null, null);
        вернуть Успех("За сегодня выпито " + сумма + " мл воды.");
    }

    функция ЗаписатьСтресс(рез) : ОтветПользователю
    {
        Хранилище.СохранитьСобытие("Стресс", "психика", "команда", ВJson(рез.Поля), null, null, null);
        если ВСтроку(рез.Поля["статус"] ?? "") = "завершён" тогда вернуть Успех("Отметил завершение стресса.");
        вернуть Успех("Записал стресс " + ВСтроку(рез.Поля["интенсивность"] ?? "") + ".");
    }

    функция ЗаписатьНастроение(рез) : ОтветПользователю
    {
        Хранилище.СохранитьСобытие("Настроение", "психика", "команда", ВJson(рез.Поля), null, null, null);
        вернуть Успех("Записал настроение " + ВСтроку(рез.Поля["оценка"] ?? "") + ".");
    }

    функция ЗаписатьСон(рез) : ОтветПользователю
    {
        Хранилище.СохранитьСобытие("Сон", "здоровье", "команда", ВJson(рез.Поля), null, null, null);
        если рез.Поля["время_начала"] != null тогда вернуть Успех("Зафиксировал начало сна.");
        если рез.Поля["время_окончания"] != null тогда вернуть Успех("Сон закрыт.");
        вернуть Успех("Сон записан.");
    }

    функция ЗаписатьПитание(рез) : ОтветПользователю
    {
        Хранилище.СохранитьСобытие("Питание", "здоровье", "команда", ВJson(рез.Поля), null, null, null);
        если рез.Поля["тип"] != null тогда вернуть Успех(ВСтроку(рез.Поля["тип"]) + " записан.");
        вернуть Успех("Питание записано.");
    }

    функция ЗаписатьТренировку(рез) : ОтветПользователю
    {
        Хранилище.СохранитьСобытие("Тренировка", "здоровье", "команда", ВJson(рез.Поля), null, null, null);
        вернуть Успех("Тренировка записана.");
    }

    функция СоздатьЗадачу(рез) : ОтветПользователю
    {
        перем id = Хранилище.СоздатьЗадачу(ВСтроку(рез.Поля["название"]), ВСтроку(рез.Поля["проект"] ?? "основной"), "работа", null, "новая");
        Хранилище.СохранитьСобытие("СоздатьЗадачу", "продуктивность", "команда", ВJson(рез.Поля), "основной", null, id);
        вернуть Успех("Задача создана.");
    }

    функция ЗакрытьЗадачу(рез) : ОтветПользователю
    {
        перем задачаId = рез.Поля["задача_id"];
        если задачаId = null и рез.Поля["название"] != null тогда
        {
            перем задача = Хранилище.НайтиЗадачуПоНазванию(ВСтроку(рез.Поля["название"]));
            если задача != null тогда задачаId = задача["ЗадачаId"];
        }
        если задачаId = null тогда вернуть Успех("Задача не найдена.");

        Хранилище.ОбновитьЗадачуСтатус(ВЦелое(задачаId), "закрыта");
        Хранилище.СохранитьСобытие("ЗакрытьЗадачу", "продуктивность", "команда", ВJson(рез.Поля), "основной", null, ВЦелое(задачаId));
        вернуть Успех("Задача закрыта.");
    }

    функция ПереоткрытьЗадачу(рез) : ОтветПользователю
    {
        перем задачаId = ВЦелое(рез.Поля["задача_id"]);
        Хранилище.ОбновитьЗадачуСтатус(задачаId, "в работе");
        Хранилище.СохранитьСобытие("ПереоткрытьЗадачу", "продуктивность", "команда", ВJson(рез.Поля), "основной", null, задачаId);
        вернуть Успех("Задача возвращена в работу.");
    }

    функция СписокЗадачНаСегодня(рез) : ОтветПользователю
    {
        перем фильтр = ВСтроку(рез.Поля["фильтр"] ?? "сегодня");
        перем проект = ВСтроку(рез.Поля["проект"] ?? "");
        перем список = Хранилище.ЗадачиНаСегодня(фильтр, проект);
        Хранилище.СохранитьСобытие("СписокЗадач", "продуктивность", "команда", ВJson(рез.Поля), "основной", null, null);
        вернуть Успех("Задач: " + Длина(список) + ".");
    }

    функция НачатьПомодоро(рез) : ОтветПользователю
    {
        если Хранилище.АктивнаяПомодороСессия() != null тогда вернуть Успех("Сессия уже активна.");
        Хранилище.СоздатьПомодороСессию(null, рез.Поля["минуты_работы"], рез.Поля["минуты_отдыха"]);
        Хранилище.СохранитьСобытие("НачатьПомодоро", "продуктивность", "команда", ВJson(рез.Поля), "основной", null, null);
        вернуть Успех("Помодоро запущен.");
    }

    функция ЗавершитьПомодоро(рез) : ОтветПользователю
    {
        если Хранилище.АктивнаяПомодороСессия() = null тогда вернуть Успех("Нет активной сессии.");
        перем статус = ВСтроку(рез.Поля["статус_завершения"] ?? "завершена");
        Хранилище.ЗавершитьАктивнуюПомодороСессию(статус);
        Хранилище.СохранитьСобытие("ЗавершитьПомодоро", "продуктивность", "команда", "{}", "основной", null, null);
        вернуть Успех("Сессия завершена.");
    }

    функция ДобавитьКлиента(рез) : ОтветПользователю
    {
        перем клиентId = Хранилище.СоздатьИлиОбновитьКлиента(ВСтроку(рез.Поля["телефон"] ?? ""), ВСтроку(рез.Поля["фио"]), "");
        Хранилище.СохранитьСобытие("ДобавитьКлиента", "crm", "команда", ВJson(рез.Поля), null, клиентId, null);
        вернуть Успех("Клиент добавлен.");
    }

    функция КлиентОплатил(рез) : ОтветПользователю
    {
        перем сумма = ВЧисло(рез.Поля["сумма"]);
        перем клиент = Хранилище.НайтиКлиентаПоИмени(ВСтроку(рез.Поля["клиент"] ?? ""));
        перем клиентId = если клиент != null тогда ВЦелое(клиент["КлиентId"]) иначе 0;
        Хранилище.СоздатьСделку(клиентId, сумма, "оплачена", "Оплата от клиента");
        Хранилище.СохранитьСобытие("КлиентОплатил", "crm", "команда", ВJson(рез.Поля), null, клиентId, null);
        вернуть Успех("Оплата отмечена.");
    }

    функция КарточкаКлиента(рез) : ОтветПользователю
    {
        Хранилище.СохранитьСобытие("КарточкаКлиента", "crm", "команда", ВJson(рез.Поля), null, null, null);
        вернуть Успех("Карточка клиента: " + ВСтроку(рез.Поля["фио"]) + ".");
    }

    функция СоздатьСделку(рез) : ОтветПользователю
    {
        перем клиент = Хранилище.НайтиКлиентаПоИмени(ВСтроку(рез.Поля["клиент"] ?? ""));
        перем клиентId = если клиент != null тогда ВЦелое(клиент["КлиентId"]) иначе 0;
        Хранилище.СоздатьСделку(клиентId, ВЧисло(рез.Поля["сумма"]), "новая", "Сделка по команде");
        Хранилище.СохранитьСобытие("СоздатьСделку", "crm", "команда", ВJson(рез.Поля), null, клиентId, null);
        вернуть Успех("Сделка создана.");
    }

    функция ОбновитьСтадиюСделки(рез) : ОтветПользователю
    {
        Хранилище.ОбновитьСделкуСтадия(ВСтроку(рез.Поля["клиент"] ?? ""), ВСтроку(рез.Поля["стадия"] ?? "переговоры"));
        Хранилище.СохранитьСобытие("ОбновитьСтадиюСделки", "crm", "команда", ВJson(рез.Поля), null, null, null);
        вернуть Успех("Стадия обновлена.");
    }

    функция ЗакрытьСделку(рез) : ОтветПользователю
    {
        Хранилище.СохранитьСобытие("ЗакрытьСделку", "crm", "команда", ВJson(рез.Поля), null, null, null);
        вернуть Успех("Сделка закрыта.");
    }

    функция ОтчётЗаДень(рез) : ОтветПользователю
    {
        перем дата = ВСтроку(рез.Поля["дата"] ?? ФорматДаты(Сейчас(), "yyyy-MM-dd"));
        перем отчёт = Отчёты.СформироватьОтчётЗаДень(Хранилище, дата);
        Хранилище.СохранитьОтчётДня(дата, отчёт["индекс_дня"], ВJson(отчёт));
        Хранилище.СохранитьСобытие("ОтчётЗаДень", "управление", "команда", ВJson(отчёт), null, null, null);
        вернуть Успех("Сводка за день. Индекс дня: " + отчёт["индекс_дня"] + ".");
    }

    функция ИндексДня(рез) : ОтветПользователю
    {
        перем индекс = Отчёты.ИндексДня(0, Хранилище.ПоследнийСтрессЗаДень(ФорматДаты(Сейчас(), "yyyy-MM-dd")), 0, 0, 0);
        вернуть Успех("Текущий индекс дня: " + индекс + ".");
    }

    функция Успех(текст) : ОтветПользователю
    {
        вернуть новый ОтветПользователю { Успех = истина, ТекстОтвета = текст };
    }
}
