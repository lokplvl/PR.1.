// Perfolenta.NET

класс МаршрутизаторWorkflow
{
    приватное поле Обработчики : ОбработчикиWorkflow;

    конструктор(обработчики : ОбработчикиWorkflow)
    {
        Обработчики = обработчики;
    }

    функция Выполнить(результат : РезультатИнтерпретации) : ОтветПользователю
    {
        выбрать результат.Интенция
        {
            когда "ЗаписатьВоду": вернуть Обработчики.ЗаписатьВоду(результат);
            когда "ПоказатьВодуЗаДень": вернуть Обработчики.ПоказатьВодуЗаДень(результат);
            когда "ЗаписатьСтресс": вернуть Обработчики.ЗаписатьСтресс(результат);
            когда "ЗаписатьНастроение": вернуть Обработчики.ЗаписатьНастроение(результат);
            когда "ЗаписатьСон": вернуть Обработчики.ЗаписатьСон(результат);
            когда "ЗаписатьПитание": вернуть Обработчики.ЗаписатьПитание(результат);
            когда "ЗаписатьТренировку": вернуть Обработчики.ЗаписатьТренировку(результат);
            когда "СоздатьЗадачу": вернуть Обработчики.СоздатьЗадачу(результат);
            когда "ЗакрытьЗадачу": вернуть Обработчики.ЗакрытьЗадачу(результат);
            когда "ПереоткрытьЗадачу": вернуть Обработчики.ПереоткрытьЗадачу(результат);
            когда "СписокЗадачНаСегодня": вернуть Обработчики.СписокЗадачНаСегодня(результат);
            когда "НачатьПомодоро": вернуть Обработчики.НачатьПомодоро(результат);
            когда "ЗавершитьПомодоро": вернуть Обработчики.ЗавершитьПомодоро(результат);
            когда "ДобавитьКлиента": вернуть Обработчики.ДобавитьКлиента(результат);
            когда "КлиентОплатил": вернуть Обработчики.КлиентОплатил(результат);
            когда "КарточкаКлиента": вернуть Обработчики.КарточкаКлиента(результат);
            когда "СоздатьСделку": вернуть Обработчики.СоздатьСделку(результат);
            когда "ОбновитьСтадиюСделки": вернуть Обработчики.ОбновитьСтадиюСделки(результат);
            когда "ЗакрытьСделку": вернуть Обработчики.ЗакрытьСделку(результат);
            когда "ОтчётЗаДень": вернуть Обработчики.ОтчётЗаДень(результат);
            иначе: вернуть новый ОтветПользователю {
                Успех = ложь,
                ТекстОтвета = "Интенция не поддерживается.",
                Ошибка = новый Ошибка { Код = "НЕИЗВЕСТНАЯ_ИНТЕНЦИЯ", Сообщение = "Нет маршрута для интенции." }
            };
        }
    }
}
