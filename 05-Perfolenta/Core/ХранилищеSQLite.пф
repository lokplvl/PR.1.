// Perfolenta.NET

класс ХранилищеSQLite
{
    приватное поле ПутьКБазе = "lifeos.db";
    приватное поле СтрокаПодключения : строка;

    процедура Инициализировать()
    {
        СтрокаПодключения = "Data Source=" + ПутьКБазе;
        если !ФайлСуществует(ПутьКБазе) тогда СоздатьФайл(ПутьКБазе);

        если !ЕстьТаблица("События") тогда
        {
            перем миграция = ПрочитатьТекст("03-СхемаБД/001_инициализация.sql");
            ВыполнитьБезРезультата(миграция);
        }
    }

    процедура СохранитьСобытие(типСобытия, контекст, источник, телоJson, проектId, клиентId, задачаId)
    {
        ВыполнитьБезРезультата(
            "INSERT INTO \"События\" (\"Время\", \"ТипСобытия\", \"Контекст\", \"Источник\", \"ТелоJson\", \"ПроектId\", \"КлиентId\", \"ЗадачаId\") VALUES (CURRENT_TIMESTAMP, @тип, @контекст, @источник, @тело, @проект, @клиент, @задача)",
            {"тип":типСобытия, "контекст":контекст, "источник":источник, "тело":телоJson, "проект":проектId, "клиент":клиентId, "задача":задачаId}
        );
    }

    функция СуммаВодыЗаДень(дата : строка) : целое
    {
        вернуть ВыполнитьСкаляр("SELECT COALESCE(SUM(CAST(json_extract(\"ТелоJson\", '$.объём_мл') AS INTEGER)),0) FROM \"События\" WHERE \"ТипСобытия\"='ВыпилВоду' AND date(\"Время\")=@дата", {"дата":дата});
    }

    функция ПоследнийСтрессЗаДень(дата : строка) : целое
    {
        вернуть ВыполнитьСкаляр("SELECT COALESCE(CAST(json_extract(\"ТелоJson\", '$.интенсивность') AS INTEGER),0) FROM \"События\" WHERE \"ТипСобытия\"='Стресс' AND date(\"Время\")=@дата ORDER BY \"Время\" DESC LIMIT 1", {"дата":дата});
    }

    функция АктивнаяПомодороСессия() : запись?
    {
        вернуть ВыполнитьЗапись("SELECT * FROM \"ПомодороСессии\" WHERE \"Статус\"='активна' ORDER BY \"Начало\" DESC LIMIT 1");
    }

    функция НайтиКлиентаПоИмени(фио : строка) : запись?
    {
        вернуть ВыполнитьЗапись("SELECT * FROM \"Клиенты\" WHERE \"ФИО\" LIKE @фио LIMIT 1", {"фио":"%" + фио + "%"});
    }

    функция СоздатьИлиОбновитьКлиента(телефон, фио, примечание) : целое
    {
        перем существующий = null;
        если !Пусто(телефон) тогда существующий = ВыполнитьСкаляр("SELECT \"КлиентId\" FROM \"Клиенты\" WHERE \"Телефон\"=@телефон LIMIT 1", {"телефон":телефон});
        если существующий = null тогда
        {
            перем поИмени = НайтиКлиентаПоИмени(фио);
            если поИмени != null тогда существующий = поИмени["КлиентId"];
        }

        если существующий != null тогда
        {
            ВыполнитьБезРезультата("UPDATE \"Клиенты\" SET \"Телефон\"=COALESCE(@т,\"Телефон\"), \"ФИО\"=@ф, \"Примечание\"=@п WHERE \"КлиентId\"=@id", {"т":телефон, "ф":фио, "п":примечание, "id":существующий});
            вернуть существующий;
        }

        ВыполнитьБезРезультата("INSERT INTO \"Клиенты\" (\"Телефон\",\"ФИО\",\"Примечание\",\"Создано\") VALUES (@т,@ф,@п,CURRENT_TIMESTAMP)", {"т":телефон, "ф":фио, "п":примечание});
        вернуть ПоследнийИдентификатор();
    }

    функция СоздатьСделку(клиентId, сумма, статус, описание) : целое
    {
        ВыполнитьБезРезультата("INSERT INTO \"Сделки\" (\"КлиентId\",\"Сумма\",\"Статус\",\"Описание\",\"Время\") VALUES (@к,@с,@ст,@о,CURRENT_TIMESTAMP)", {"к":клиентId, "с":сумма, "ст":статус, "о":описание});
        вернуть ПоследнийИдентификатор();
    }

    процедура ОбновитьСделкуСтадия(описаниеФильтр, стадия)
    {
        ВыполнитьБезРезультата("UPDATE \"Сделки\" SET \"Статус\"=@с WHERE \"Описание\" LIKE @о", {"с":стадия, "о":"%" + описаниеФильтр + "%"});
    }

    функция СоздатьЗадачу(название, проект, контекст, срок, статус) : целое
    {
        ВыполнитьБезРезультата("INSERT INTO \"Задачи\" (\"Название\",\"Проект\",\"Контекст\",\"Срок\",\"Статус\",\"Создано\") VALUES (@н,@п,@к,@с,@ст,CURRENT_TIMESTAMP)", {"н":название, "п":проект, "к":контекст, "с":срок, "ст":статус});
        вернуть ПоследнийИдентификатор();
    }

    функция НайтиЗадачуПоНазванию(название) : запись?
    {
        вернуть ВыполнитьЗапись("SELECT * FROM \"Задачи\" WHERE \"Название\" LIKE @н ORDER BY \"Создано\" DESC LIMIT 1", {"н":"%" + название + "%"});
    }

    процедура ОбновитьЗадачуСтатус(задачаId, статус)
    {
        ВыполнитьБезРезультата("UPDATE \"Задачи\" SET \"Статус\"=@ст WHERE \"ЗадачаId\"=@id", {"ст":статус, "id":задачаId});
    }

    функция ЗадачиНаСегодня(фильтр, проект) : список<запись>
    {
        если фильтр = "просроченные" тогда
            вернуть ВыполнитьСписок("SELECT * FROM \"Задачи\" WHERE date(\"Срок\") < date('now') AND \"Статус\"!='закрыта' ORDER BY \"Срок\" ASC");
        если !Пусто(проект) тогда
            вернуть ВыполнитьСписок("SELECT * FROM \"Задачи\" WHERE \"Проект\"=@п ORDER BY \"Создано\" DESC", {"п":проект});
        вернуть ВыполнитьСписок("SELECT * FROM \"Задачи\" WHERE date(\"Срок\")=date('now') OR \"Статус\"!='закрыта' ORDER BY \"Создано\" DESC");
    }

    процедура СоздатьПомодороСессию(задачаId, минутыРаботы, минутыОтдыха)
    {
        ВыполнитьБезРезультата("INSERT INTO \"ПомодороСессии\" (\"ЗадачаId\",\"Начало\",\"Конец\",\"МинутыРаботы\",\"МинутыОтдыха\",\"Статус\") VALUES (@з,CURRENT_TIMESTAMP,NULL,@р,@о,'активна')", {"з":задачаId, "р":минутыРаботы, "о":минутыОтдыха});
    }

    процедура ЗавершитьАктивнуюПомодороСессию(статус)
    {
        ВыполнитьБезРезультата("UPDATE \"ПомодороСессии\" SET \"Конец\"=CURRENT_TIMESTAMP, \"Статус\"=@ст WHERE \"СессияId\"=(SELECT \"СессияId\" FROM \"ПомодороСессии\" WHERE \"Статус\"='активна' ORDER BY \"Начало\" DESC LIMIT 1)", {"ст":статус});
    }


    процедура СохранитьОтчётДня(дата, индексДня, текст)
    {
        ВыполнитьБезРезультата("INSERT OR REPLACE INTO "ОтчётыДня" ("Дата","ИндексДня","Текст","Создано") VALUES (@д,@и,@т,CURRENT_TIMESTAMP)", {"д":дата, "и":индексДня, "т":текст});
    }

    функция СобытияЗаДень(дата) : список<запись>
    {
        вернуть ВыполнитьСписок("SELECT * FROM \"События\" WHERE date(\"Время\")=@дата ORDER BY \"Время\"", {"дата":дата});
    }
}
