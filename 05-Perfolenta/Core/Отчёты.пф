// Perfolenta.NET

модуль Отчёты
{
    функция СформироватьОтчётЗаДень(хранилище : ХранилищеSQLite, дата : строка) : словарь<строка, объект>
    {
        перем события = хранилище.СобытияЗаДень(дата);
        перем водаИтого = Сумма(события, "объём_мл", "ВыпилВоду");
        перем стрессСреднее = Среднее(события, "интенсивность", "Стресс");
        перем стрессМакс = Максимум(события, "интенсивность", "Стресс");
        перем помодороКоличество = КоличествоПоТипу(события, "НачатьПомодоро");
        перем задачиГотово = КоличествоСтатусов("Задачи", "закрыта");
        перем задачиВсего = КоличествоСтрок("Задачи");
        перем клиентыКоличество = КоличествоСтрок("Клиенты");
        перем сделкиКоличество = КоличествоСтрок("Сделки");
        перем суммаСделок = СуммаПоТаблице("Сделки", "Сумма");

        вернуть {
            "вода_итого": водаИтого,
            "стресс_среднее": стрессСреднее,
            "стресс_макс": стрессМакс,
            "помодоро_количество": помодороКоличество,
            "задачи_готово": задачиГотово,
            "задачи_всего": задачиВсего,
            "клиенты_количество": клиентыКоличество,
            "сделки_количество": сделкиКоличество,
            "сделки_сумма": суммаСделок,
            "индекс_дня": ИндексДня(водаИтого, стрессСреднее, помодороКоличество, задачиГотово, задачиВсего)
        };
    }

    функция ИндексДня(водаИтого, стрессСреднее, помодороКоличество, задачиГотово, задачиВсего) : число
    {
        перем водаПроцент = Минимум(1.0, водаИтого / 2000.0);
        перем стрессБалл = Максимум(0.0, (10.0 - стрессСреднее) / 10.0);
        перем помодороБалл = Минимум(1.0, помодороКоличество / 8.0);
        перем задачиБалл = если задачиВсего = 0 тогда 1.0 иначе задачиГотово / задачиВсего;

        вернуть Округлить((водаПроцент + стрессБалл + помодороБалл + задачиБалл) / 4.0 * 100.0, 1);
    }
}
