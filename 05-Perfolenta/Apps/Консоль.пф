// Perfolenta.NET

модуль КонсольПриложение
{
    процедура Запуск()
    {
        перем хранилище = новый ХранилищеSQLite();
        хранилище.Инициализировать();

        перем обработчики = новый ОбработчикиWorkflow(хранилище);
        перем маршрутизатор = новый МаршрутизаторWorkflow(обработчики);

        перем активныйКлючДиалога : строка = null;
        перем контекстДиалога : словарь<строка, объект> = новый словарь<строка, объект>();

        пока истина
        {
            Печать("Вы> ");
            перем ввод = ЧитатьСтроку();
            если Пусто(ввод) тогда продолжить;
            если НижнийРегистр(ввод) = "выход" тогда выйти;

            перем команда = новый КомандаПользователя {
                Текст = ввод,
                ВремяПолучения = Сейчас(),
                ИдентификаторПользователя = "локальный",
                КлючДиалога = активныйКлючДиалога ?? НовыйGuid()
            };

            перем результат = ИнтерпретаторКоманд.Интерпретировать(команда, контекстДиалога);

            если результат.НужноУточнение тогда
            {
                активныйКлючДиалога = результат.КлючДиалога;
                контекстДиалога = результат.Поля;
                Печать("Ассистент> " + результат.Вопрос);
                продолжить;
            }

            перем ответ = маршрутизатор.Выполнить(результат);
            Печать("Ассистент> " + ответ.ТекстОтвета);

            активныйКлючДиалога = null;
            контекстДиалога = новый словарь<строка, объект>();
        }
    }
}
