// Perfolenta.NET

класс TelegramАдаптер
{
    приватное поле Хранилище : ХранилищеSQLite;
    приватное поле Обработчики : ОбработчикиWorkflow;
    приватное поле Маршрутизатор : МаршрутизаторWorkflow;
    приватное поле КонтекстДиалогаПоЧату : словарь<строка, словарь<строка, объект>>;

    // Технические Telegram-поля допустимы только в этом файле.
    приватное поле botToken : строка;
    приватное поле chatId : строка;

    конструктор(техническийТокен : строка, техническийChatId : строка)
    {
        botToken = техническийТокен;
        chatId = техническийChatId;

        Хранилище = новый ХранилищеSQLite();
        Хранилище.Инициализировать();

        Обработчики = новый ОбработчикиWorkflow(Хранилище);
        Маршрутизатор = новый МаршрутизаторWorkflow(Обработчики);

        КонтекстДиалогаПоЧату = новый словарь<строка, словарь<строка, объект>>();
    }

    функция ПринятьСообщение(текст : строка) : ОтветПользователю
    {
        перем ключЧата = chatId ?? "локальный-чат";
        перем контекст = КонтекстДиалогаПоЧату[ключЧата] ?? новый словарь<строка, объект>();

        перем команда = новый КомандаПользователя {
            Текст = текст,
            ВремяПолучения = Сейчас(),
            ИдентификаторПользователя = ключЧата,
            КлючДиалога = ключЧата
        };

        перем результат = ИнтерпретаторКоманд.Интерпретировать(команда, контекст);

        если результат.НужноУточнение тогда
        {
            КонтекстДиалогаПоЧату[ключЧата] = результат.Поля;
            перем уточнение = новый ОтветПользователю { Успех = истина, ТекстОтвета = результат.Вопрос };
            ОтправитьОтвет(уточнение.ТекстОтвета);
            вернуть уточнение;
        }

        перем ответ = Маршрутизатор.Выполнить(результат);
        КонтекстДиалогаПоЧату[ключЧата] = новый словарь<строка, объект>();

        ОтправитьОтвет(ответ.ТекстОтвета);
        вернуть ответ;
    }

    процедура ОтправитьОтвет(текст : строка)
    {
        // Каркас отправки в Telegram без реальных API-ключей и сетевых вызовов.
        Лог("Telegram->" + chatId + ": " + текст);
    }
}
